# Copie para .env e ajuste. Nunca faça commit do .env.

# development | test | production
NODE_ENV=development

# Porta HTTP da API (na nuvem o provedor costuma definir PORT)
PORT=3333

# Banco local (docker compose). Em produção, use a URL do Postgres gerenciado com ?sslmode=require
DATABASE_URL=postgresql://bilheteria:bilheteria@localhost:5433/bilheteria?schema=public

# Segredo do JWT: no mínimo 32 caracteres. Em produção, gere um valor aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32+-caracteres
JWT_EXPIRES_IN=1d

# Minutos que uma reserva fica pendente antes de expirar
RESERVA_MINUTOS=10

# Validação na entrada: a partir de quantos minutos antes do início o ingresso pode ser validado
# (vale até o fim do filme). Para demonstrar com uma sessão futura qualquer, use um valor alto (ex.: 100000).
VALIDACAO_ANTECEDENCIA_MINUTOS=60

# Origens permitidas no CORS, separadas por vírgula.
# 127.0.0.1:8081 permite testar dois clientes ao mesmo tempo no navegador (origem diferente = login separado).
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://127.0.0.1:8081

# Primeiro OPERADOR, criado/atualizado pelo seed (npm run seed). Use uma senha forte (mín. 8 caracteres).
SEED_OPERADOR_NOME=Operador
SEED_OPERADOR_EMAIL=operador@bilheteria.local
SEED_OPERADOR_SENHA=troque-esta-senha
